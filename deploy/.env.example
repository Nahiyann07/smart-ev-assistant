SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_URL=jdbc:mysql://database-host:3306/smart_ev_assistant?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=smart_ev_app
DB_PASSWORD=replace-with-a-strong-production-password

# Optional. Leave blank to use the clickable no-key location preview.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=
GOOGLE_ROUTES_SERVER_KEY=

# Single-instance safeguards. Use equivalent shared edge limits when clustered.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ENTRIES=10000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=10
REGISTRATION_RATE_LIMIT_WINDOW=1h
ROUTE_RATE_LIMIT_MAX_ATTEMPTS=30
ROUTE_RATE_LIMIT_WINDOW=1m
