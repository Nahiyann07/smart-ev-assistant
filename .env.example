# Copy these values into environment variables. Do not commit real passwords.
DB_URL=jdbc:mysql://localhost:3306/smart_ev_assistant?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=smart_ev_app
DB_PASSWORD=replace-with-a-strong-local-password
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Set false only when TLS is terminated by a trusted hosting proxy.
REQUIRE_HTTPS=true

# Public browser key: restrict by HTTP referrer and to Maps JavaScript API only.
GOOGLE_MAPS_BROWSER_KEY=
# Required by Advanced Markers. Create this in Google Cloud Map Management.
GOOGLE_MAP_ID=
# Private server key: restrict by server IP and to Routes API only.
GOOGLE_ROUTES_SERVER_KEY=

# Optional isolated preview seeding. Keep disabled for real production data.
PREVIEW_SEED_ENABLED=false
PREVIEW_DRIVER_EMAIL=
PREVIEW_DRIVER_PASSWORD=
PREVIEW_ADMIN_EMAIL=
PREVIEW_ADMIN_PASSWORD=

# Optional: required only when running the full OWASP dependency audit.
NVD_API_KEY=

# Single-instance application safeguards; keep equivalent edge limits for clustered deployments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ENTRIES=10000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=10
REGISTRATION_RATE_LIMIT_WINDOW=1h
ROUTE_RATE_LIMIT_MAX_ATTEMPTS=30
ROUTE_RATE_LIMIT_WINDOW=1m
